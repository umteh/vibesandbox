# ─── Supabase ─────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── Email encryption ─────────────────────────────────────────────────────────
# CRITICAL: Never rotate this after launch without a migration.
# Generate: openssl rand -hex 32
EMAIL_ENCRYPTION_KEY=your_64_char_hex_string_here

# ─── Scorer HMAC ──────────────────────────────────────────────────────────────
# Shared secret between this app and the Fly.io scorer worker.
# Generate: openssl rand -hex 32
SCORER_HMAC_SECRET=your_scorer_hmac_secret_here

# ─── Scorer worker ────────────────────────────────────────────────────────────
# URL of the Fly.io scorer worker (fire-and-forget from POST /api/listings)
SCORER_URL=https://scorer.fly.dev/score

# ─── Admin accounts (comma-separated, bypass rate limits) ─────────────────────
ADMIN_EMAILS=you@example.com

# ─── Email relay (Resend) ─────────────────────────────────────────────────────
# Get your API key at: https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
# Must match a domain you've verified in Resend
RESEND_FROM_DOMAIN=vibesandbox.app
